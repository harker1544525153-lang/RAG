# ===== 复制为 backend/.env 后按需修改 =====

# ---------- 业务数据库（免费云库推荐 Neon / Supabase） ----------
# 本地默认 SQLite，无需配置；云端改成 Postgres 连接串即可自动切换业务库与 pgvector 向量库
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=sqlite:///C:/path/to/backend/data/rag.db

# ---------- 向量库 ----------
# auto：按 DATABASE_URL 自动选择（sqlite -> 内置 SQLite 向量表，postgres -> pgvector）
# 可选：auto / sqlite / pgvector / chroma
VECTOR_BACKEND=auto
VECTOR_COLLECTION=rag_docs

# ---------- 向量化模型（local / openai / hash） ----------
# 说明：以下各项均可在管理端「设置 → 模型服务 → 向量化」覆盖（保存即生效）；
#       更换方式或模型名后，需在设置页点「立即重建向量索引」。
# local：本地 BGE，离线可用，首次自动下载；资源紧张可改 bge-small-zh-v1.5（约 100MB）
# openai：OpenAI 兼容 Embedding API（云端推荐，零本地模型依赖）
# hash：确定性哈希向量，仅用于离线联调/CI
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
# pgvector 建表维度（0 = 按模型自动推断）
EMBEDDING_DIM=0
EMBEDDING_BATCH_SIZE=10

# openai 兼容 Embedding（阿里云百炼 / SiliconFlow / 智谱 / OpenAI）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=qwen3.7-text-embedding-flash

# ---------- HuggingFace 网络与离线 ----------
# 国内直连 huggingface.co 会超时重试数十秒，导致首次提问长时间无响应
# 模型已下载到本地缓存后建议开启下面两个离线开关（换新模型时把 OFFLINE 改为 0）
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# 首次下载模型时走国内镜像（若 OFFLINE=0 才生效）
HF_ENDPOINT=https://hf-mirror.com

# ---------- LLM（OpenAI 兼容协议，支持阿里云百炼 / DeepSeek） ----------
# 说明：Key / Base URL / 模型名 / 温度均可在管理端「设置 → 模型服务」配置并立即生效；
#       这里的值仅作为「管理端未保存过该项」时的默认回退。
# 默认优先级：配置了 DASHCOPE_API_KEY 则用百炼，否则用 DeepSeek
# 阿里云百炼（推荐国内使用，延迟低）
# 默认留空：请在管理端「设置 → 模型服务」填写（保存即生效）；也可在此填默认值
DASHCOPE_API_KEY=
DASHCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼模型可选：qwen3.8-flash / qwen-plus / qwen-max / qwen-long
LLM_MODEL=qwen3.8-flash

# DeepSeek（二选一，不填百炼时使用）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 生成温度（0~2）：越小越稳定，越大越发散
LLM_TEMPERATURE=0.3

# ---------- 联网搜索（Tavily，可在管理端「设置 → 模型服务 / 联网搜索」配置） ----------
# Key 申请：https://tavily.com ；Key / 地址也可直接填在管理端设置页（保存即生效）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# 每次联网返回的网页条数（管理端也可调整）
TAVILY_MAX_RESULTS=5
# 默认开关与模式（管理端保存后会覆盖这两项）
# always：每次提问都联网；fallback：仅知识库未命中时联网
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MODE=fallback

# ---------- 分块 / 检索默认值（可在「设置」页运行时调整） ----------
CHUNK_SIZE=450
CHUNK_OVERLAP=60
TOP_K=2
SCORE_THRESHOLD=0.4

# ---------- 初始知识库 ----------
# 启动时自动导入项目根目录 DOC/ 下的文档（按哈希去重）
SEED_ON_STARTUP=true
# DOC_DIR=../DOC

# ---------- 服务 ----------
HOST=0.0.0.0
# 后端端口；前端 `npm run dev` 也从这里起步（被后端占用时自动顺延），代理目标同样读此值
PORT=8080
MAX_FILE_SIZE_MB=50
# 生产环境收敛为实际前端域名，多个用英文逗号分隔
ALLOW_ORIGINS=*
