{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install --no-audit --no-fund && npm run build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": [
        "backend/app/**",
        "frontend/dist/**",
        "user/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
